# =============================================================================
# Application
# =============================================================================
APP_NAME="Trade Logistics Management"
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000                  # container port
APP_PORT_FORWARD=8000          # host port -> http://localhost:8000/docs
APP_LOG_LEVEL=info

# =============================================================================
# PostgreSQL (LTS) - one schema per module: "shipment" and "customs"
# =============================================================================
POSTGRES_HOST=postgres         # service name inside docker-compose network
POSTGRES_PORT=5432             # container port
POSTGRES_PORT_FORWARD=5432     # host port -> localhost:5432
POSTGRES_DB=trade_logistics
POSTGRES_USER=trade_logistics
POSTGRES_PASSWORD=change_me

# Async driver used by the application (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://trade_logistics:change_me@postgres:5432/trade_logistics
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Module schemas
SHIPMENT_SCHEMA=shipment
CUSTOMS_SCHEMA=customs

# =============================================================================
# pgAdmin
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@trade-logistics.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=80                # container port
PGADMIN_PORT_FORWARD=5050      # host port -> http://localhost:5050

# =============================================================================
# RabbitMQ (LTS) - wiring is deferred; the broker is provisioned already.
# =============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672                  # AMQP container port
RABBITMQ_PORT_FORWARD=5672          # host port -> amqp://localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672      # management UI container port
RABBITMQ_MANAGEMENT_PORT_FORWARD=15672  # host port -> http://localhost:15672
RABBITMQ_DEFAULT_USER=trade_logistics
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://trade_logistics:change_me@rabbitmq:5672/

# -----------------------------------------------------------------------------
# Message bus topology. Every value here is also a `handle-messages` flag, so a
# worker can be pointed at a different queue without a rebuild.
# -----------------------------------------------------------------------------
RABBITMQ_APP_NAME=trade-logistics-management
RABBITMQ_HEARTBEAT=30

RABBITMQ_PRIMARY_EXCHANGE=trade-logistics.topic
RABBITMQ_PRIMARY_EXCHANGE_TYPE=topic
RABBITMQ_PRIMARY_QUEUE=trade-logistics.default
RABBITMQ_PRIMARY_BINDING_KEY=trade-logistics.#

RABBITMQ_RETRY_EXCHANGE=trade-logistics.retry
RABBITMQ_RETRY_EXCHANGE_TYPE=topic
RABBITMQ_RETRY_QUEUE=trade-logistics.default.retry
RABBITMQ_RETRY_BINDING_KEY=trade-logistics.default.retry
RABBITMQ_RETRY_MESSAGE_TTL_MS=10000   # delay before a retry returns to the queue

RABBITMQ_ERROR_EXCHANGE=trade-logistics.error
RABBITMQ_ERROR_EXCHANGE_TYPE=topic
RABBITMQ_ERROR_QUEUE=trade-logistics.error
RABBITMQ_ERROR_ROUTING_KEY=trade-logistics.dead-letter

RABBITMQ_IMMEDIATE_RETRIES=3          # in-process, before the retry queue
RABBITMQ_DELAYED_RETRIES=3            # trips through the retry queue, then DLQ
RABBITMQ_DISPATCH_LIMIT=10            # outbox rows per dispatch-messages run
RABBITMQ_CONSUME_LIMIT=10             # prefetch count of handle-messages
